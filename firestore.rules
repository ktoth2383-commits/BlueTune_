rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // Felhasználói profil + felhős mentés (users/{uid}/backup/latest)
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email;

      match /backup/{doc} {
        allow read, write: if isOwner(uid);
      }
    }

    // Hírlevél-feliratkozás (innen szinkronizál a Brevo). Csak a saját, kifejezett hozzájárulással.
    match /subscribers/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.consent == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email', 'consent', 'consentAt', 'source']);
    }

    // Közösségi presetek
    match /community_presets/{id} {
      allow read: if signedIn();

      allow create: if verified()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.likes == 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 30
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 200
        && request.resource.data.settings is string
        && request.resource.data.settings.size() < 4000;

      // Bárki lájkolhat, de csak +1-gyel, és mást nem módosíthat
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes == resource.data.likes + 1;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
